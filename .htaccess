RewriteEngine On

# Serve arquivos estáticos a partir da pasta public
RewriteRule ^assets/(.*)$ public/assets/$1 [L,NC]
RewriteRule ^api/(.*)$ public/api/$1 [L,NC]
RewriteRule ^dashboard\.php$ public/dashboard.php [L,NC]
RewriteRule ^gerar_admin\.php$ public/gerar_admin.php [L,NC]

# Se o arquivo/pasta existir na raiz, entrega normalmente
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Front controller (subpasta /eleicao ou raiz)
RewriteRule ^ index.php [L,QSA]

